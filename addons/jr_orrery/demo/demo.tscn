[node name="Demo" type="Node" node_paths=PackedStringArray("info_panel", "instructions_container", "collapse_button", "title_label", "scenario_selector", "overview_label", "camera_status_label", "controls_label", "reference_status_label", "switch_view_button")]
script = ExtResource("1_ctrl")
scenario_scenes = Array[PackedScene]([ExtResource("2_scen_planetary"), ExtResource("3_scen_leo"), ExtResource("4_scen_lagrange"), ExtResource("5_scen_binary"), ExtResource("6_scen_swarm")])
scenario_titles = PackedStringArray("1. Planetary System & Submoons", "2. Real-Scale LEO (1 AU) & Low-Thrust Spiral", "3. Planet–Moon Lagrange Points (Stable L4 & L5)", "4. Binary Stars & Circumbinary Planet", "5. GPU Asteroid Swarm (256 Ballistic Bodies)")
scenario_descriptions = PackedStringArray("Hierarchical Keplerian system (JrRailOrbiter) with planets, moons, a submoon (RheaSubmoon), and GPU ballistic probes (JrBallisticOrbiter) with live trajectory forecasts and wakes.", "Real-scale Sun–Earth–Moon system in Kilometers & Seconds (Earth at 1 AU = 149.6M km). Showcases a drift-free 400 km Low Earth Orbit satellite and an ORBITAL-frame prograde ion-thrust spiral at 600x time warp.", "Co-rotating Planet–Moon synodic reference frame (PerspectiveRotationMode.SYNODIC_ORBITAL) locked to MajorMoon around HostPlanet. Showcases stable L4 (+60° leading) and L5 (-60° trailing) Trojan tadpole orbits.", "Massless barycenter (JrOrbitDriver, mass = 0) with reciprocally coupled binary stars (StarAlpha & StarBeta via binary_partner), a circumbinary planet, and a ballistic probe navigating the dual gravity wells.", "Batched GLSL compute-shader N-body stepping of 256 JrBallisticOrbiter asteroids perturbed by a massive gas giant (JupiterPerturber), using collect_ballistic_nodes() to flatten the simulation hierarchy.")
info_panel = NodePath("UILayer/HUDRoot/InfoPanel")
instructions_container = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/InstructionsContainer")
collapse_button = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/HeaderRow/CollapseButton")
title_label = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/HeaderRow/TitleLabel")
scenario_selector = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/InstructionsContainer/ScenarioRow/ScenarioSelector")
overview_label = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/InstructionsContainer/OverviewLabel")
camera_status_label = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/InstructionsContainer/CameraStatusLabel")
controls_label = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/InstructionsContainer/ControlsLabel")
reference_status_label = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/InstructionsContainer/ReferenceStatusLabel")
switch_view_button = NodePath("UILayer/HUDRoot/InfoPanel/MarginContainer/VBoxContainer/InstructionsContainer/SwitchViewButton")

